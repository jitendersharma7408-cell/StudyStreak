{
  "name": "QuizAttempt",
  "type": "object",
  "properties": {
    "student_id": {
      "type": "string"
    },
    "student_name": {
      "type": "string"
    },
    "day": {
      "type": "string"
    },
    "mode": {
      "type": "string",
      "enum": [
        "daily",
        "practice"
      ],
      "default": "daily"
    },
    "status": {
      "type": "string",
      "enum": [
        "in_progress",
        "completed"
      ],
      "default": "completed"
    },
    "score": {
      "type": "integer",
      "default": 0
    },
    "wrong": {
      "type": "integer",
      "default": 0
    },
    "previous_stars": {
      "type": "integer",
      "default": 0
    },
    "star_change": {
      "type": "integer",
      "default": 0
    },
    "updated_stars": {
      "type": "integer",
      "default": 0
    },
    "xp_earned": {
      "type": "integer",
      "default": 0
    },
    "question_ids": {
      "type": "string"
    },
    "answers": {
      "type": "string"
    },
    "completed_at": {
      "type": "string"
    }
  },
  "required": [
    "student_id",
    "day",
    "mode"
  ]
}